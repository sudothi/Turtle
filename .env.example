DATABASE_URL=postgres://turtle:turtle@localhost:5432/turtle
# URL que o navegador usa para falar com o LiveKit (produção: wss://lk.ogturtle.xyz)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-1234
PORT=3000
BOOTSTRAP_INVITE=troque-este-codigo

# Waiting list: os cadastros sempre ficam no banco. Preencha para encaminhar as
# notificações pendentes. SMTP_FROM deve ser um remetente autorizado no provedor.
# 587 usa SMTP_SECURE=false (STARTTLS); 465 usa SMTP_SECURE=true (TLS).
# Segredos apenas no .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WAITLIST_NOTIFY_TO=tchemello@ucs.br
