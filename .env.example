DATABASE_URL=postgres://turtle:turtle@localhost:5432/turtle
# URL que o navegador usa para falar com o LiveKit (produção: wss://lk.seudominio.com)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-1234
PORT=3000
BOOTSTRAP_INVITE=troque-este-codigo

# Waiting list: os cadastros sempre ficam no banco. Preencha SMTP_* e WAITLIST_NOTIFY_TO (e-mail que recebe o aviso) para
# encaminhar as notificações pendentes; sem os dois, nada é enviado. SMTP_FROM deve ser um remetente autorizado no provedor.
# 587 usa SMTP_SECURE=false (STARTTLS); 465 usa SMTP_SECURE=true (TLS).
# Segredos apenas no .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Origens do site público autorizadas a enviar a fila de espera (CORS), separadas por vírgula.
SITE_ORIGINS=https://seusite.com
WAITLIST_NOTIFY_TO=

# Discoteca (bot de música da chamada). Com YTDLP_PATH, toca links do YouTube, SoundCloud e Bandcamp
# e a música completa na busca; sem ele, só prévias de 30 s do Deezer. A imagem Docker já traz o yt-dlp.
YTDLP_PATH=
# Argumentos extras do yt-dlp (padrão: --js-runtimes node). Ex.: --cookies /data/cookies.txt
YTDLP_ARGS=
# Caminho de um cookies.txt (formato Netscape) de uma conta Google descartável, para o YouTube não pedir login no IP da VPS.
# O arquivo fica só no servidor (nunca no repositório); o yt-dlp usa uma cópia temporária a cada download.
YTDLP_COOKIES=
MUSIC_CACHE_DIR=
MUSIC_CACHE_MB=1024
