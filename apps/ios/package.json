    "ipa": "node scripts/ipa.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@livekit/react-native": "3.1.0",
    "@livekit/react-native-expo-plugin": "1.1.0",
    "@livekit/react-native-webrtc": "150.1.1",
    "@turtle/protocol": "workspace:*",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "livekit-client": "^2.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  }
