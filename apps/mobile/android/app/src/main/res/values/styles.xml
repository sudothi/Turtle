<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema do app: tudo preto, como o Turtle. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/turtle_black</item>
        <item name="android:statusBarColor">@color/turtle_black</item>
        <item name="android:navigationBarColor">@color/turtle_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/turtle_black</item>
    </style>

    <!-- Tela de abertura: fundo preto com a tartaruga no meio. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/turtle_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@color/turtle_black</item>
    </style>
</resources>
