# Copie para infra/.env (no VPS: ~/turtle/.env) e preencha. Nunca faça commit do .env.
DOMAIN_APP=app.ogturtle.xyz
DOMAIN_LK=lk.ogturtle.xyz
POSTGRES_PASSWORD=troque-por-uma-senha-longa
# O compose monta LIVEKIT_KEYS ("chave: segredo") a partir destes dois.
LIVEKIT_API_KEY=troque
LIVEKIT_API_SECRET=troque-por-um-segredo-com-32-ou-mais-caracteres
# Código do primeiro cadastro; depois do primeiro usuário criado ele não é mais usado.
BOOTSTRAP_INVITE=troque-por-um-codigo-dificil
