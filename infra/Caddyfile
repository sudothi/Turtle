# HTTPS automático (Let's Encrypt). O WebSocket do chat (/ws) passa pelo mesmo proxy.
# Tudo que o app serve, compartilhado entre o domínio atual e o antigo.
(app) {
	encode zstd gzip

	# Cabeçalhos de segurança (#93). A CSP começa em Report-Only: o navegador só avisa
	# no console o que bloquearia. Depois de uns dias sem avisos, troque o nome para
	# Content-Security-Policy para valer de verdade.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' wss://{$DOMAIN_LK} https://{$DOMAIN_LK}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Instalador e auto-atualização do app desktop (arquivos em ~/turtle/desktop/ na VPS).
	handle_path /desktop/* {
		root * /srv/desktop
		@manifesto path *.yml
		header @manifesto Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy api:3000
	}
}

# Domínio interno do app (login, chat, voz e /desktop/). O site público fica em outro domínio (GitHub Pages).
{$DOMAIN_APP} {
	import app
}

# Domínio antigo: APK e desktop antigos ainda usam a API e o /desktop/ daqui. Quem abre no navegador (navegação de
# página, exceto /desktop/) recebe 410: ogturtle.xyz e o app não têm ligação nenhuma (decisão do thiago, 2026-11-11); a API, o WebSocket e /desktop/ continuam respondendo aqui
# para o APK e para o auto-update do desktop antigo. Remova este bloco quando todo mundo estiver na versão nova.
{$DOMAIN_APP_LEGACY} {
	@pagina {
		header Sec-Fetch-Mode navigate
		not path /desktop/*
	}
	respond @pagina "Endereço desativado." 410
	import app
}

# Sinalização do LiveKit (roda em network_mode: host na VPS; as mídias vão direto pelas portas 7881/tcp, 7882/udp e 3478/udp).
{$DOMAIN_LK} {
	reverse_proxy host.docker.internal:7880
}
