# HTTPS automático (Let's Encrypt). O WebSocket do chat (/ws) passa pelo mesmo proxy.
app.{$DOMAIN} {
	encode zstd gzip

	# Instalador e auto-atualização do app desktop (arquivos em infra/desktop/ no VPS).
	handle_path /desktop/* {
		root * /srv/desktop
		@manifesto path *.yml
		header @manifesto Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}

# Sinalização do LiveKit (as mídias vão direto pelas portas 7881/tcp, 7882/udp e 3478/udp).
lk.{$DOMAIN} {
	reverse_proxy livekit:7880
}
