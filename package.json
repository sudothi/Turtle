{
  "name": "turtle",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "desktop": "pnpm --filter @turtle/desktop start",
    "desktop:dist": "pnpm --filter @turtle/desktop dist",
    "ios": "pnpm --filter @turtle/ios start",
    "ios:device": "pnpm --filter @turtle/ios ios",
    "ios:ipa": "pnpm --filter @turtle/ios ipa"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
